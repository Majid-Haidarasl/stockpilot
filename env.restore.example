# Restore-drill env TEMPLATE. Copy to env.restore (gitignored):
#   Copy-Item env.restore.example env.restore
# Always use: docker compose ... -p stockpilot-restore --env-file env.restore
# Never down -v. Never point this at the default stockpilot or stockpilot-prodlike projects.

STOCKPILOT_RESTORE_CONFIRM=stockpilot-restore
STOCKPILOT_IMAGE_TAG=local

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_SUPERUSER_DB=postgres

STOCKPILOT_MIGRATOR_PASSWORD=migrator_dev_change_me
STOCKPILOT_APP_PASSWORD=app_dev_change_me
STOCKPILOT_RELAY_PASSWORD=relay_dev_change_me
STOCKPILOT_METRICS_PASSWORD=metrics_dev_change_me
STOCKPILOT_BACKUP_PASSWORD=backup_dev_change_me
KEYCLOAK_DB_PASSWORD=keycloak_dev_change_me

STOCKPILOT_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/postgres
STOCKPILOT_METRICS_DATABASE_URL=postgresql+psycopg://stockpilot_metrics:metrics_dev_change_me@postgres:5432/stockpilot

RABBITMQ_DEFAULT_USER=stockpilot
RABBITMQ_DEFAULT_PASS=rabbit_dev_change_me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

STOCKPILOT_OIDC_CLIENT_SECRET=stockpilot-dev-client-secret-change-me
STOCKPILOT_TOKEN_ENCRYPTION_KEY=dev-only-fernet-key-32bytes-long!!
STOCKPILOT_OIDC_ISSUER=http://keycloak:8080/realms/stockpilot
STOCKPILOT_OIDC_REDIRECT_URI=http://localhost:8200/auth/callback
STOCKPILOT_OIDC_ALLOWED_REDIRECT_URIS=http://localhost:8200/auth/callback
STOCKPILOT_APP_PUBLIC_ORIGIN=http://localhost:8200
STOCKPILOT_CORS_ORIGINS=http://localhost:5173
STOCKPILOT_FRONTEND_DEFAULT_URL=http://localhost:5173
STOCKPILOT_ENVIRONMENT=development
STOCKPILOT_COOKIE_SECURE=false

# PRACTICE restic repo (external volume stockpilot_restic_practice from default project).
RESTIC_REPOSITORY=/var/lib/stockpilot/restic-practice
RESTIC_PASSWORD=practice_restic_password_change_me
RESTIC_SNAPSHOT=latest
