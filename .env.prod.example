# Production env template. Copy to a host path outside git (e.g. /etc/stockpilot/.env),
# fill real values, chmod 600. Never commit real secrets, domains, or IPs.

# --- Image / hosts (placeholders) ---
STOCKPILOT_IMAGE_TAG=REPLACE_WITH_GIT_SHA
STOCKPILOT_PUBLIC_HOST=example.com
STOCKPILOT_AUTH_HOST=auth.example.com
ACME_EMAIL=ops@example.com
STOCKPILOT_KEYCLOAK_REALM_FILE=/etc/stockpilot/keycloak-realm.json

# GHCR images (lowercase owner):
#   ghcr.io/majid-haidarasl/stockpilot-backend:${STOCKPILOT_IMAGE_TAG}
#   ghcr.io/majid-haidarasl/stockpilot-edge:${STOCKPILOT_IMAGE_TAG}

# --- PostgreSQL ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace_me
POSTGRES_SUPERUSER_DB=postgres

STOCKPILOT_MIGRATOR_PASSWORD=replace_me
STOCKPILOT_APP_PASSWORD=replace_me
STOCKPILOT_RELAY_PASSWORD=replace_me
STOCKPILOT_METRICS_PASSWORD=replace_me
KEYCLOAK_DB_PASSWORD=replace_me

# Ops ensure-db-roles only (never wire into api/relay/migrate/worker).
STOCKPILOT_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:replace_me@postgres:5432/postgres
STOCKPILOT_METRICS_DATABASE_URL=postgresql+psycopg://stockpilot_metrics:replace_me@postgres:5432/stockpilot

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=stockpilot
RABBITMQ_DEFAULT_PASS=replace_me

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_me

# --- App / OIDC ---
STOCKPILOT_OIDC_CLIENT_SECRET=replace_me
STOCKPILOT_TOKEN_ENCRYPTION_KEY=replace_with_fernet_or_long_secret
# Derived in compose.prod.yaml from STOCKPILOT_PUBLIC_HOST / STOCKPILOT_AUTH_HOST:
# STOCKPILOT_OIDC_ISSUER, REDIRECT, CORS, COOKIE_SECURE=true, ENVIRONMENT=production

# --- Observability (profile) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me
STOCKPILOT_API_METRICS_ENABLED=true
STOCKPILOT_WORKER_IDLE_HEARTBEAT_SECONDS=60

# --- Media ---
STOCKPILOT_MEDIA_DIR=/var/lib/stockpilot/media
STOCKPILOT_IMAGE_MAX_BYTES=5242880
STOCKPILOT_IMAGE_MAX_PIXELS=24000000

# --- Relay tuning (optional) ---
STOCKPILOT_OUTBOX_BATCH_SIZE=50
STOCKPILOT_OUTBOX_LEASE_SECONDS=30
STOCKPILOT_RELAY_POLL_SECONDS=1
