# Copy to .env for local overrides. Do not commit real secrets.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_SUPERUSER_DB=postgres

POSTGRES_HOST_PORT=5432
# Prefer 8200 on Windows: Hyper-V often reserves 7911-8010 (includes 8000).
API_HOST_PORT=8200
FRONTEND_HOST_PORT=5173

# Prefer 8180 on Windows: Hyper-V often reserves 8011-8110 (includes 8080).
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_MGMT_HOST_PORT=9000

STOCKPILOT_MIGRATOR_PASSWORD=migrator_dev_change_me
STOCKPILOT_APP_PASSWORD=app_dev_change_me
KEYCLOAK_DB_PASSWORD=keycloak_dev_change_me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

STOCKPILOT_OIDC_CLIENT_SECRET=stockpilot-dev-client-secret-change-me
STOCKPILOT_TOKEN_ENCRYPTION_KEY=dev-only-fernet-key-32bytes-long!!
STOCKPILOT_OIDC_ISSUER=http://localhost:8180/realms/stockpilot
STOCKPILOT_OIDC_REDIRECT_URI=http://localhost:8200/auth/callback
STOCKPILOT_OIDC_ALLOWED_REDIRECT_URIS=http://localhost:8200/auth/callback
STOCKPILOT_APP_PUBLIC_ORIGIN=http://localhost:8200
STOCKPILOT_CORS_ORIGINS=http://localhost:5173
STOCKPILOT_FRONTEND_DEFAULT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8200
