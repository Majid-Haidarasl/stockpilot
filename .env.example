# Copy to .env for local overrides. Do not commit real secrets.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_SUPERUSER_DB=postgres

# Host publish port for Postgres (change if 5432 is already taken on Windows)
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Dev-only placeholders — replace before any shared/staging use
STOCKPILOT_MIGRATOR_PASSWORD=migrator_dev_change_me
STOCKPILOT_APP_PASSWORD=app_dev_change_me
KEYCLOAK_DB_PASSWORD=keycloak_dev_change_me
