# Local prod-like env TEMPLATE. Copy to env.prodlike (gitignored) and fill values:
#   Copy-Item env.prodlike.example env.prodlike
# Also copy the Keycloak realm template:
#   Copy-Item infra\keycloak\realm\stockpilot-realm.prodlike.example.json infra\keycloak\realm\stockpilot-realm.prodlike.json
# Then set matching client secret / user password in both files.
# Project: stockpilot-prodlike. Never commit env.prodlike or the filled realm JSON.

STOCKPILOT_IMAGE_TAG=localprod
STOCKPILOT_PUBLIC_HOST=stockpilot.local
STOCKPILOT_AUTH_HOST=auth.stockpilot.local
ACME_EMAIL=ops@example.com
STOCKPILOT_KEYCLOAK_REALM_FILE=./infra/keycloak/realm/stockpilot-realm.prodlike.json

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME
POSTGRES_SUPERUSER_DB=postgres

STOCKPILOT_MIGRATOR_PASSWORD=REPLACE_ME
STOCKPILOT_APP_PASSWORD=REPLACE_ME
STOCKPILOT_RELAY_PASSWORD=REPLACE_ME
STOCKPILOT_METRICS_PASSWORD=REPLACE_ME
STOCKPILOT_BACKUP_PASSWORD=REPLACE_ME
KEYCLOAK_DB_PASSWORD=REPLACE_ME

# Required for compose.prod.yaml interpolation even when backup profile is off.
# Practice-only values for local prod-like — not a real off-host repository.
RESTIC_REPOSITORY=/var/lib/stockpilot/restic-practice
RESTIC_PASSWORD=REPLACE_ME

STOCKPILOT_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@postgres:5432/postgres
STOCKPILOT_METRICS_DATABASE_URL=postgresql+psycopg://stockpilot_metrics:REPLACE_ME@postgres:5432/stockpilot

RABBITMQ_DEFAULT_USER=stockpilot
RABBITMQ_DEFAULT_PASS=REPLACE_ME

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME

STOCKPILOT_OIDC_CLIENT_SECRET=REPLACE_WITH_STOCKPILOT_OIDC_CLIENT_SECRET
STOCKPILOT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_OR_LONG_SECRET

# Match fixed Keycloak user id in stockpilot-realm.prodlike.json after you copy the template.
STOCKPILOT_SUBJECT_AFTAB_ADMIN=11111111-1111-1111-1111-111111111111

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
STOCKPILOT_API_METRICS_ENABLED=true
STOCKPILOT_WORKER_IDLE_HEARTBEAT_SECONDS=60

# Run 6.4 load-test only (never enable on a real production VPS).
# seed-load refuses unless ENVIRONMENT=production AND this flag is true.
STOCKPILOT_ALLOW_LOAD_SEED=true
STOCKPILOT_LOAD_PASSWORD=REPLACE_LOAD_PASSWORD
# Written by infra/prodlike/ensure_load_users.py (gitignored results path).
STOCKPILOT_LOAD_SUBJECTS_FILE=/results/load-subjects.json
