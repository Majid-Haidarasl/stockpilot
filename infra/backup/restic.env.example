# Copy to a host-only file (never commit). Placeholders only.
# Production off-host examples (pick one):
# RESTIC_REPOSITORY=s3:https://s3.example.com/REPLACE_BUCKET
# RESTIC_REPOSITORY=sftp:backup@backup-host.example:/restic
#
# Local PRACTICE ONLY (same machine — NOT a host-loss test):
RESTIC_REPOSITORY=/var/lib/stockpilot/restic-practice
RESTIC_PASSWORD=replace_me_practice_only

# Optional S3-compatible credentials (leave empty for local/SFTP):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

STOCKPILOT_BACKUP_INTERVAL_SECONDS=43200
STOCKPILOT_BACKUP_CHECK_EVERY_N=14
STOCKPILOT_IMAGE_TAG=local
